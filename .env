APP_DEBUG=1
APP_ENV=dev
APP_SYSTEM=core-dam
APP_SECRET=S3cretV22u3
APP_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
APP_VERSION=0.0.0
APP_READ_ONLY_MODE=false

REDIS_HOST=redis-core
REDIS_PORT=6379
REDIS_DB=11

REDIS_CACHE_HOST=redis-core
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=11

DB_CORE_DAM_USER=root
DB_CORE_DAM_PASS=root
DB_CORE_DAM_HOST=mysql-core
DB_CORE_DAM_PORT=3306
DB_CORE_DAM_NAME=books
DB_CORE_DAM_URL=mysql://${DB_CORE_DAM_USER}:${DB_CORE_DAM_PASS}@${DB_CORE_DAM_HOST}:${DB_CORE_DAM_PORT}/${DB_CORE_DAM_NAME}?serverVersion=8.0

DOCTRINE_CACHE_ENABLED=true
DOCTRINE_CACHE_TTL=86400

ANZU_MONGODB_APP_LOG_URI=mongodb://mongo-core:27017
ANZU_MONGODB_APP_LOG_USERNAME=root
ANZU_MONGODB_APP_LOG_PASSWORD=admin
ANZU_MONGODB_APP_LOG_SSL=false
ANZU_MONGODB_APP_LOG_DB=weather

ANZU_MONGODB_AUDIT_LOG_URI=mongodb://mongo-core:27017
ANZU_MONGODB_AUDIT_LOG_USERNAME=root
ANZU_MONGODB_AUDIT_LOG_PASSWORD=admin
ANZU_MONGODB_AUDIT_LOG_SSL=false
ANZU_MONGODB_AUDIT_LOG_DB=weather

#MESSENGER_TRANSPORT_DSN=gps://default
MESSENGER_TRANSPORT_DSN=sync://
PUBSUB_EMULATOR_HOST=http://pubsub-core:8538

COOKIE_DOMAIN=.sme.localhost
COOKIE_SECURE=false
SECURE_CHANNEL=http

SSO_USER_INFO_URL=https://central-access.smestaging.sk/rest/api/user/info
SSO_CLIENT_ID=sme-ng
