#!/bin/bash
# Script to run bash inside the container

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
DOCKER_CONTAINER="core-dam"
USER_SWITCH="--user user"

cd "${PROJECT_ROOT}" || exit 1

function help() {
    echo -en "$(printf %q "${BASH_SOURCE[0]}") [OPERATION] [OPTIONS]...
    \nBash script used to run bash in the application docker container

    Container:
        core-dam      Run bash in the core-dam docker container (default)
        core-dam-cron Run bash in the core-dam-cron docker container

    Options:
        --root        (Optional) Run bash as root in the docker container

    Examples:
        $(printf %q "${BASH_SOURCE[0]}") --root
        $(printf %q "${BASH_SOURCE[0]}") core-dam-cron
    \n"
}

# Go through all command line arguments and setup variables accordingly
while [ "$#" -gt 0 ]; do
    case $1 in
    core-dam)
        DOCKER_CONTAINER=$1
        shift 1
        continue
        ;;
    core-dam-cron)
        DOCKER_CONTAINER=$1
        shift 1
        continue
        ;;
    --root)
        USER_SWITCH="--user root"
        shift 1
        continue
        ;;
    -h | --help)
        help
        exit
        ;;
    *)
        echo "[WARN] Unknown command line switch: $1"
        shift 1
        ;;
    esac
done

bin/docker-compose exec "${USER_SWITCH}" "${DOCKER_CONTAINER}" bash
