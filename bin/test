#!/bin/bash
# Script used to run PHPUnit tests in the application container

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
ARGS="$*"

cd "${PROJECT_ROOT}" || exit 1

if [ -f /.dockerenv ]; then
    echo "[INFO] Running PHPUnit tests"
    vendor/symfony/phpunit-bridge/bin/simple-phpunit --configuration /var/www/html/phpunit.xml.dist "${ARGS}"
    exit
fi

bin/docker-compose exec core-dam bash -c \'bin/test "${ARGS}"\'
