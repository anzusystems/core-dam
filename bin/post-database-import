#!/bin/bash
# Script used to run post database import commands in the application container

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
ELASTIC_REBUILD=true
USER_SYNC_BASE=true

cd "${PROJECT_ROOT}" || exit 1

function help() {
    echo -en "$(printf %q "${BASH_SOURCE[0]}") [OPERATION] [OPTIONS]...
    \nBash script used to run post database import commands in the application container

    Options:
        --elastic-rebuild (Optional) Run specifically elasticsearch index rebuild
        --user-sync-base  (Optional) Run specifically user sync base

    Examples:
        $(printf %q "${BASH_SOURCE[0]}") --elastic-rebuild
        $(printf %q "${BASH_SOURCE[0]}") --elastic-rebuild --user-sync-base
        $(printf %q "${BASH_SOURCE[0]}")
    \n"
}

function elastic_snapshot_restore() {
    ELASTIC_SNAPSHOT_REPO="elasticsearch-production-backup-s3-bucket"
    ELASTIC_SNAPSHOT_INDEX_PREFIX="core_dam"
    ELASTIC_PREFIX="${ELASTIC_PREFIX:-core_dam}"
    ELASTIC_HOST=$(echo "${ELASTIC_HOSTS:-"[\"http://elasticsearch-anzu:9200\"]"}" | tr -d '[]" ' | cut -d',' -f1)
    ELASTIC_AUTH_ARGS=("-u" "${ELASTIC_USERNAME}:${ELASTIC_PASSWORD}")
    ELASTIC_RESTORE_MAX_WAIT=900       # 15 minutes max wait
    ELASTIC_RESTORE_CHECK_INTERVAL=10  # Check every 10 seconds

    echo "[INFO] Fetching second latest snapshot from repository: ${ELASTIC_SNAPSHOT_REPO}"
    for i in {1..5}; do
        ELASTIC_SNAPSHOT=$( \
            curl -s "${ELASTIC_AUTH_ARGS[@]}" \
                "${ELASTIC_HOST}/_snapshot/${ELASTIC_SNAPSHOT_REPO}/_all?sort=start_time&order=desc" |
            grep -o '"snapshot":"[^"]*"' | cut -d'"' -f4 | head -2 | tail -1 \
        )
        if [ -n "${ELASTIC_SNAPSHOT}" ]; then
           break
        fi
        echo "[WARN] No snapshot found (attempt ${i}/5), retrying in 10s..."
        sleep 10
    done
    if [ -z "${ELASTIC_SNAPSHOT}" ]; then
        echo "[ERROR] No snapshot found in repository: ${ELASTIC_SNAPSHOT_REPO}"
        return
    fi
    echo "[INFO] Selected snapshot: ${ELASTIC_SNAPSHOT}"

    echo "[INFO] Force deleting existing indices with prefix ${ELASTIC_PREFIX}_*"
    curl -s "${ELASTIC_AUTH_ARGS[@]}" -X POST "${ELASTIC_HOST}/${ELASTIC_PREFIX}_*/_close?ignore_unavailable=true" >/dev/null 2>&1
    sleep 2
    curl -s "${ELASTIC_AUTH_ARGS[@]}" -X DELETE "${ELASTIC_HOST}/${ELASTIC_PREFIX}_*?ignore_unavailable=true&allow_no_indices=true&expand_wildcards=all" >/dev/null 2>&1 #;
    sleep 3
    readarray -t REMAINING_INDICES < <(curl -s "${ELASTIC_AUTH_ARGS[@]}" "${ELASTIC_HOST}/_cat/indices/${ELASTIC_PREFIX}_*?h=index" 2>/dev/null)
    if [ ${#REMAINING_INDICES[@]} -gt 0 ]; then
        echo "[WARN] Force deleting ${#REMAINING_INDICES[@]} remaining indices individually..."
        for index in "${REMAINING_INDICES[@]}"; do
            curl -s "${ELASTIC_AUTH_ARGS[@]}" -X DELETE "${ELASTIC_HOST}/${index}?ignore_unavailable=true" >/dev/null 2>&1 #;
        done
        sleep 2
    fi
    echo "[INFO] Index deletion completed"

    echo "[INFO] Restoring ${ELASTIC_SNAPSHOT_INDEX_PREFIX}_* prefixed indexes"
    RESTORE_JSON="{
        \"indices\": \"${ELASTIC_SNAPSHOT_INDEX_PREFIX}_*\",
        \"ignore_unavailable\": true,
        \"include_global_state\": false,
        \"index_settings\": {
            \"index.number_of_replicas\": 0
        }
    }"
    if [ "${ELASTIC_PREFIX}" != "${ELASTIC_SNAPSHOT_INDEX_PREFIX}" ]; then
        echo "[INFO] Renaming to ${ELASTIC_PREFIX}_* prefix"
        RESTORE_JSON="{
            \"indices\": \"${ELASTIC_SNAPSHOT_INDEX_PREFIX}_*\",
            \"ignore_unavailable\": true,
            \"include_global_state\": false,
            \"rename_pattern\": \"${ELASTIC_SNAPSHOT_INDEX_PREFIX}_(.*)\",
            \"rename_replacement\": \"${ELASTIC_PREFIX}_\$1\",
            \"index_settings\": {
                \"index.number_of_replicas\": 0
            }
        }"
    fi

    echo "[INFO] Initiating snapshot restore..."
    RESTORE_RESPONSE=$( \
        curl -s -w "\n%{http_code}" "${ELASTIC_AUTH_ARGS[@]}" \
            -X POST "${ELASTIC_HOST}/_snapshot/${ELASTIC_SNAPSHOT_REPO}/${ELASTIC_SNAPSHOT}/_restore?wait_for_completion=false" \
            -H 'Content-Type: application/json' \
            -d "${RESTORE_JSON}" \
    )
    HTTP_CODE=$(echo "${RESTORE_RESPONSE}" | tail -n1)

    if [ "${HTTP_CODE}" != "200" ]; then
        RESPONSE_BODY=$(echo "${RESTORE_RESPONSE}" | head -n-1)
        echo "[ERROR] Failed to initiate restore. HTTP code: ${HTTP_CODE}"
        echo "[ERROR] Response: ${RESPONSE_BODY}"
        return
    fi

    echo "[INFO] Querying expected indices from snapshot..."
    SNAPSHOT_INDICES_JSON=$( \
        curl -s "${ELASTIC_AUTH_ARGS[@]}" \
            -X GET "${ELASTIC_HOST}/_snapshot/${ELASTIC_SNAPSHOT_REPO}/${ELASTIC_SNAPSHOT}" 2>/dev/null \
    )
    EXPECTED_COUNT=$(echo "${SNAPSHOT_INDICES_JSON}" | grep -o '"indices":\[[^]]*\]' | grep -o "\"${ELASTIC_SNAPSHOT_INDEX_PREFIX}_[^\"]*\"" | wc -l)
    if [ "${EXPECTED_COUNT}" -eq 0 ]; then
        echo "[ERROR] Could not determine expected index count from snapshot, or no ${ELASTIC_SNAPSHOT_INDEX_PREFIX}_* indices found"
        return
    fi
    echo "[INFO] Expecting ${EXPECTED_COUNT} index(es) to be restored from snapshot"

    echo "[INFO] Waiting for restore to complete (max ${ELASTIC_RESTORE_MAX_WAIT}s)..."
    ELAPSED=0
    while [ ${ELAPSED} -lt ${ELASTIC_RESTORE_MAX_WAIT} ]; do
        RECOVERY_STATUS=$(curl -s "${ELASTIC_AUTH_ARGS[@]}" "${ELASTIC_HOST}/_cat/recovery/${ELASTIC_PREFIX}_*?h=index,type,stage,snapshot&s=index" 2>/dev/null)
        ACTUAL_RECOVERY=$(echo "${RECOVERY_STATUS}" | grep "${ELASTIC_SNAPSHOT}" || true)
        RESTORING_COUNT=$(echo "${ACTUAL_RECOVERY}" | grep -v "done" | grep -c "snapshot" || true)
        DONE_COUNT=$(echo "${ACTUAL_RECOVERY}" | grep "done" | grep -c "snapshot" || true)

        if [ "${DONE_COUNT}" -ge "${EXPECTED_COUNT}" ] && [ "${RESTORING_COUNT}" -eq 0 ]; then
            echo "[INFO] Snapshot restore completed successfully (${DONE_COUNT}/${EXPECTED_COUNT} indices done)"
            break
        fi

        if [ "${DONE_COUNT}" -eq 0 ] && [ "${RESTORING_COUNT}" -eq 0 ]; then
            echo "[INFO] Waiting for snapshot restore to start... (${ELAPSED}s elapsed)"
            sleep 1
            ELAPSED=$((ELAPSED + 1))
            continue
        fi

        RESTORING_INDICES=$(echo "${ACTUAL_RECOVERY}" | grep -v "done" | grep "snapshot" | awk '{print $1}' | sort -u | tr '\n' ', ' | sed 's/,$//')
        echo "[INFO] Elastic snapshot restore in progress (${DONE_COUNT}/${EXPECTED_COUNT} done, ${RESTORING_COUNT} restoring): ${RESTORING_INDICES}"
        sleep ${ELASTIC_RESTORE_CHECK_INTERVAL}
        ELAPSED=$((ELAPSED + ELASTIC_RESTORE_CHECK_INTERVAL))

        if [ ${ELAPSED} -ge ${ELASTIC_RESTORE_MAX_WAIT} ]; then
            echo "[ERROR] Restore operation timed out after ${ELASTIC_RESTORE_MAX_WAIT} seconds (${DONE_COUNT}/${EXPECTED_COUNT} done)"
            return
        fi
    done
}

# Go through all command line arguments and setup variables accordingly
while [ "$#" -gt 0 ]; do
    case $1 in
    --elastic-rebuild)
        ELASTIC_REBUILD_ARG=true
        shift 1
        continue
        ;;
    --user-sync-base)
        USER_SYNC_BASE_ARG=true
        shift 1
        continue
        ;;
    -h | --help)
        help
        exit
        ;;
    *)
        echo "[WARN] Unknown command line switch: $1"
        shift 1
        ;;
    esac
done

if [ -n "${ELASTIC_REBUILD_ARG}" ] || [ -n "${USER_SYNC_BASE_ARG}" ] ; then
    ELASTIC_REBUILD=${ELASTIC_REBUILD_ARG:-false}
    USER_SYNC_BASE=${USER_SYNC_BASE_ARG:-false}
fi

echo "[INFO] Disable crons in crontab"
crontab -r

if ${USER_SYNC_BASE}; then
    echo "[INFO] Run anzu user sync"
    bin/console anzusystems:user:sync-base --file="${USER_SYNC_DATA_FILE_PATH:-/var/tmp/users.json}"
fi

if ${ELASTIC_REBUILD}; then
    echo "[INFO] Dropping, restoring and rebuilding all elasticsearch indexes"
    elastic_snapshot_restore

    echo "[INFO] Run elastic rebuild"
    bin/console anzu:elastic:rebuild keyword
    bin/console anzu:elastic:rebuild author
    bin/console anzu:elastic:rebuild distribution
    bin/console anzu:elastic:rebuild asset --no-drop --since="1 week"
fi

echo "[INFO] Setup crontab"
DOCKER_CRONTAB_FILE="docker/crontab/crontab"
if [ -f "docker/crontab/crontab_${DEPLOY_ENV}" ]; then
    DOCKER_CRONTAB_FILE="docker/crontab/crontab_${DEPLOY_ENV}"
fi
crontab "${DOCKER_CRONTAB_FILE}"
