### Create assest with associated image file
POST {{host}}/api/adm/v1/image/licence/1
Content-Type: application/json

{
  "mimeType": "image/jpeg",
  "checksum": "123456"
}

> {%
  client.global.set('imageId', response.body.id)
  client.global.set('assetId', response.body.asset)
%}

### Upload chunk 1
POST {{host}}/api/adm/v1/image/{{imageId}}/chunk
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="filename.jpg"

< ../../tests/data/chunk/chunkaa

--boundary
Content-Disposition: form-data; name="chunk";
Content-Type: application/json

{
  "offset": 0,
  "size": 262144
}

### Upload chunk 2
POST {{host}}/api/adm/v1/image/{{imageId}}/chunk
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="filename.jpg"

< ../../tests/data/chunk/chunkab

--boundary
Content-Disposition: form-data; name="chunk";
Content-Type: application/json

{
  "offset": 262144,
  "size": 61242
}

### Finish upload
PATCH {{host}}/api/adm/v1/image/{{imageId}}/uploaded
Content-Type: application/json

### Preview image
GET {{host}}/image/w500-h500-c0/{{imageId}}

### Bulk update
PATCH {{host}}/api/adm/v1/asset/bulk-update
Content-Type: application/json

[
  {
    "id": "{{assetId}}",
    "title": "Title",
    "description": "Description",
    "described": true
  }
]

### Create ROI
POST {{host}}/api/adm/v1/image/{{imageId}}/roi
Content-Type: application/json

{
  "image": "{{imageId}}",
  "pointX": 0,
  "pointY": 0,
  "percentageWidth": 0.1,
  "percentageHeight": 0.1
}

> {%
  client.global.set('roiId', response.body.id)
%}

### Get ROI list by image
GET {{host}}/api/adm/v1/image/{{imageId}}/roi

### Get ROI list by image
PATCH {{host}}/api/adm/v1/roi/{{roiId}}
Content-Type: application/json

{
  "image": "{{imageId}}",
  "id": "{{roiId}}",
  "pointX": 2,
  "pointY": 0,
  "percentageWidth": 0.5,
  "percentageHeight": 1.0,
  "title": "aaa"
}

### Get ROI list by image
DELETE {{host}}/api/adm/v1/roi/{{roiId}}
