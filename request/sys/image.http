// /sme/6/31/3129176/3129176.jpeg
// https://m.smedata.sk/api-media/media/image/sme/3/88/8893563/8893563.jpg

// /sme/0/67/67000030/6700030.jpeg
// /sme/3/88/8893563/8893563.jpg

{
  "mediaApiId": 8893563,
  "fullPath": "/sme/6/22/2255366/2255366.jpeg",
  "idStock": 5,
  "keywords": "",
  "author": "",
  "description": "",
  "focusX": 1500,
  "focusY": 1334,
  "createdAt": "2024-09-30T18:00:14.000000Z",
