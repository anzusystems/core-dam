### Login admin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "dam_admin@anzusystems.dev",
  "password": "admin"
}

### GET Podcast episodes
GET {{host}}/api/adm/v1/podcast-episode/podcast/1ed76c43-2365-6bbc-842e-39673057d810
Content-Type: application/json

### GET Asset episodes
GET {{host}}/api/adm/v1/podcast-episode/asset/1ed76cf7-9022-6732-bdd3-69835d8cc8a2
Content-Type: application/json

### Create podcast episode
POST {{host}}/api/adm/v1/podcast-episode
Content-Type: application/json

{
  "podcast": "5edeb44d-c64b-4357-957d-688d9cf7e63a",
  "texts": {
    "title": "New episode"
  },
  "attributes": {
    "seasonNumber": 1,
    "episodeNumber": 1
  }
}

> {%
  client.global.set('podcastEpisodeId', response.body.id)
%}

### Get single podcast episode
GET {{host}}/api/adm/v1/podcast-episode/{{podcastEpisodeId}}
Content-Type: application/json

### Update podcast episode
PUT {{host}}/api/adm/v1/podcast-episode/{{podcastEpisodeId}}
Content-Type: application/json

{
  "id": "{{podcastEpisodeId}}",
  "asset": "1ed724c0-1fd4-6cca-a962-fd00e5bd9602",
  "podcast": "1ed724c0-1677-651a-801c-fd00e5bd9602",
  "attributes": {
    "seasonNumber": 1,
    "episodeNumber": 1
  }
}

### Delete podcast episode
DELETE {{host}}/api/adm/v1/podcast-episode/{{podcastEpisodeId}}
Content-Type: application/json

