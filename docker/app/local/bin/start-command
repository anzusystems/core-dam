#!/bin/bash
# Script to run setup inside the container
set -e

cd /var/www/html || exit 1

echo "[INFO] Setup private key"
cp /run/secrets/ssh_private_key "$HOME/.ssh/id_rsa"

echo "[INFO] Redirecting logs to stdout"
tail-cmd -f "\
    /var/log/newrelic/newrelic-daemon.log \
    ${PHP_ERROR_LOG} \
" &

if [ -n "${GITHUB_PERSONAL_ACCESS_TOKEN}" ]; then
    echo "[INFO] Setup token for github.com"
    cat <<EOF >/composer/auth.json
{
    "github-oauth": {
        "github.com": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
    }
}
EOF
fi

if [ -d vendor ]; then
    echo "[INFO] Trying to setup messenger transports"
    messengers_setup_count=0
    while [[ "${messengers_setup_count}" -lt 3 ]]; do
        sleep 2
        if bin/console messenger:setup-transports; then
            break
        fi
        _=$((messengers_setup_count++))
    done &
fi

echo "[INFO] Starting supervisor"
messenger-supervisor-conf
/usr/bin/supervisord
