#!/bin/bash
# Script to run migrations inside the container
set -e

cd /var/www/html || exit 1

echo "[INFO] Composer install"
composer -n install 2>&1

echo "[INFO] Composer dump-autoload"
composer dump-autoload --classmap-authoritative 2>&1

echo "[INFO] Messenger setup transport"
bin/console messenger:setup-transport

echo "[INFO] Doctrine migrations"
bin/console doctrine:database:create --if-not-exists
bin/console doctrine:migrations:sync-metadata-storage --no-interaction
bin/console doctrine:migrations:migrate --no-interaction --allow-no-migration

echo "[INFO] Synchronize DistributionCategorySelect according ext systems distribution requirements"
bin/console anzu-dam:distribution:sync-category-select
