#!/bin/bash
# Script used to run start setup inside the container
set -e

cd /var/www/html || exit 1

echo "[INFO] Redirecting logs to stdout"
tail-cmd -f "\
    /var/log/cron/cron.log \
    /var/log/newrelic/newrelic-daemon.log \
    ${PHP_ERROR_LOG} \
" &

if ${ENABLE_AUTOMATIC_CRON_STARTUP}; then
    DOCKER_CRONTAB_FILE="docker/crontab/crontab"
    if [ -f "docker/crontab/crontab_local" ]; then
        DOCKER_CRONTAB_FILE="docker/crontab/crontab_local"
    fi
    su -c "crontab ${DOCKER_CRONTAB_FILE}" user
fi

echo "[INFO] Starting supervisor"
supervisord -c /etc/supervisor/supervisord.conf
